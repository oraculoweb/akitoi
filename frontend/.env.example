# API Backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth (panel de administración de clubes)
# Con estas variables el login usa Supabase (email+contraseña o magic
# link). Sin ellas, el panel ofrece el modo demo local: pegar un token
# generado con `python scripts/make_demo_token.py`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
